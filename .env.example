# Copy to backend/.env  (never commit the real file). Values without spaces/quotes please.
DJANGO_SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=hotel_db
DB_USER=hotel
DB_PASSWORD=hotel
DB_HOST=localhost
DB_PORT=5432

# Email: console backend prints emails in the terminal (dev). Switch to SMTP only in P4-01 if needed.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@hotel.local

LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173
